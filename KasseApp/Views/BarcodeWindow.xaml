<Window x:Class="KasseApp.Views.BarcodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barcode"
        Height="260"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#FF0F172A"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Basis-Button -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="999"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FF4B5563"/>
                                <Setter Property="Foreground" Value="#FF9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF22C55E"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFDC2626"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF111827"/>
            <Setter Property="BorderBrush" Value="#FF374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="BarcodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF111827"/>
            <Setter Property="BorderBrush" Value="#FF374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="#FF111827"
            BorderBrush="#FF1F2937"
            BorderThickness="1"
            Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titelzeile -->
            <Grid Grid.Row="0"
                  Background="#FF111827"
                  MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtTitleBar"
                           Text="Barcode-Scan"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>

                <Button Content="✕"
                        Width="32"
                        Height="24"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#F97373"
                        Grid.Column="1"
                        Margin="0,0,4,0"
                        Click="Close_Click"/>
            </Grid>

            <!-- Inhalt -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Eingabe -->
                <TextBox x:Name="txtBarcodeInput"
                         Grid.Row="0"
                         Style="{StaticResource BarcodeTextBoxStyle}"
                         VerticalContentAlignment="Center"
                         TextChanged="txtBarcodeInput_TextChanged"/>

                <!-- Große Anzeige -->
                <TextBlock x:Name="txtBarcodeDisplay"
                           Grid.Row="1"
                           Margin="0,10,0,0"
                           TextAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <!-- Artikelinfo -->
                <TextBlock x:Name="txtArtikelInfo"
                           Grid.Row="2"
                           Margin="0,10,0,0"
                           TextAlignment="Center"
                           FontSize="14"
                           Foreground="#FF9CA3AF"
                           TextWrapping="Wrap"/>
            </Grid>

            <!-- Buttons unten -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <Button x:Name="btnAdd"
                        Content="✓"
                        Width="44"
                        Height="44"
                        Margin="0,0,8,0"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="btnAdd_Click"/>
                <Button x:Name="btnRemove"
                        Content="✗"
                        Width="44"
                        Height="44"
                        Margin="0,0,8,0"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="btnRemove_Click"/>
                <Button x:Name="btnZusatzZahlAdd"
                        Content="H"
                        Width="44"
                        Height="44"
                        Margin="0,0,8,0"
                        Style="{StaticResource BaseButtonStyle}"
                        Click="btnZusatzZahlAdd_Click"/>
                <Button x:Name="btnZusatzZahlRemove"
                        Content="L"
                        Width="44"
                        Height="44"
                        Margin="0,0,8,0"
                        Style="{StaticResource BaseButtonStyle}"
                        Click="btnZusatzZahlRemove_Click"/>
                <Button x:Name="btnClose"
                        Content="Schließen"
                        Width="90"
                        Height="32"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
