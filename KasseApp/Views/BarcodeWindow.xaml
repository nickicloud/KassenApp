<Window x:Class="KasseApp.Views.BarcodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barcode" Height="260" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtBarcodeInput" FontSize="20" Grid.Row="0"
                 VerticalContentAlignment="Center" />

        <TextBlock x:Name="txtBarcodeDisplay" Grid.Row="1" Margin="0,10,0,0"
                   TextAlignment="Center" FontSize="26" FontWeight="Bold" />

        <TextBlock x:Name="txtArtikelInfo" Grid.Row="2" Margin="0,10,0,0"
                   TextAlignment="Center" FontSize="16" />

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnAdd" Content="✓" Width="60" Margin="5"/>
            <Button x:Name="btnRemove" Content="✗" Width="60" Margin="5"/>
            <Button x:Name="btnClose" Content="Schließen" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>