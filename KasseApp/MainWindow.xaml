<Window x:Class="KasseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kassensystem"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F172A"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FF4B5563"/>
                                <Setter Property="Foreground" Value="#FF9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF2563EB"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF111827"/>
            <Setter Property="BorderBrush" Value="#FF374151"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFDC2626"/>
        </Style>

        <!-- ContextMenu für leeren Bereich -->
        <ContextMenu x:Key="cmEmpty">
            <MenuItem Click="Menu_Refresh_Click"/>
            <Separator/>
            <MenuItem IsCheckable="True"
                      Click="Menu_ToggleZero_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#FF111827"
            BorderBrush="#FF1F2937"
            BorderThickness="1"
            Padding="0"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titelzeile -->
            <Grid Grid.Row="0"
                  Background="#FF111827"
                  MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="Assets/icon.jpg"
                           Width="28"
                           Height="28"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"/>
                    <TextBlock x:Name="txtHeaderTitle"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="_"
                            Width="40"
                            Height="28"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#FF9CA3AF"
                            Click="Minimize_Click"/>
                    <Button Content="□"
                            Width="40"
                            Height="28"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#FF9CA3AF"
                            Click="Maximize_Click"/>
                    <Button Content="✕"
                            Width="40"
                            Height="28"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#F97373"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Hauptinhalt -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Such- und Aktionsleiste -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        CornerRadius="8"
                        Background="#FF1F2937"
                        Padding="12"
                        Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left">
                            <Border CornerRadius="6"
                                    Background="#FF111827"
                                    Padding="8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔎"
                                               FontSize="14"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSearch"
                                             Width="220"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="White"
                                             CaretBrush="White"
                                             FontSize="13"
                                             TextChanged="TxtSearch_TextChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <Button x:Name="btnBarcode"
                                    Width="110"
                                    Height="32"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button x:Name="btnPay"
                                    Width="110"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Artikelliste -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        CornerRadius="8"
                        Background="#FF1F2937"
                        Padding="8">
                    <DataGrid x:Name="dgArtikel"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MouseDoubleClick="dgArtikel_MouseDoubleClick"
                              PreviewMouseRightButtonDown="dgArtikel_PreviewMouseRightButtonDown"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              RowHeight="32"
                              ColumnHeaderHeight="36"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              HorizontalGridLinesBrush="#FF374151"
                              VerticalGridLinesBrush="#FF374151"
                              AlternatingRowBackground="#FF111827">

                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="cmArtikel">
                                <MenuItem x:Name="miCopyId" Click="Menu_CopyId_Click"/>
                                <MenuItem x:Name="miAddToCart" Click="Menu_AddToCart_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF111827"/>
                                <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#FF374151"/>
                                <Setter Property="Padding" Value="8,0,8,0"/>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF111827"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#402563EB"/>
                                        <Setter Property="BorderBrush" Value="#FF2563EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colBarcode" Width="*"
                                                Binding="{Binding Barcode}" />
                            <DataGridTextColumn x:Name="colName" Width="2*"
                                                Binding="{Binding Name}" />
                            <DataGridTextColumn x:Name="colPreis" Width="*"
                                                Binding="{Binding Preis}" />
                            <DataGridTextColumn x:Name="colBestand" Width="*"
                                                Binding="{Binding Bestand}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Barcode-Verlauf rechts -->
                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        CornerRadius="8"
                        Background="#FF1F2937"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="lblHistoryHeader"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <ListBox x:Name="lstBarcodeHistory"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FF9CA3AF"
                                     SelectionChanged="lstBarcodeHistory_SelectionChanged"
                                     DisplayMemberPath="Barcode"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,8,0,0"
                                CornerRadius="6"
                                Background="#FF111827"
                                Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="lblDetailHeader"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblDetailBarcode"
                                           Foreground="#FF9CA3AF"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblDetailName"
                                           Foreground="#FF9CA3AF"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblDetailPreis"
                                           Foreground="#FF9CA3AF"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblDetailBestand"
                                           Foreground="#FF9CA3AF"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblDetailMenge"
                                           Foreground="#FF9CA3AF"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Untere Button-Leiste -->
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button x:Name="btnNew"
                            Width="90"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="btnEdit"
                            Width="100"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="btnDelete"
                            Width="90"
                            Height="30"
                            Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
